  "keyframes": [
    { "seq": 1,  "start": 0.0,  "end": 3.4,  "beat": "OPENING" },
    { "seq": 2,  "start": 3.4,  "end": 6.5,  "beat": "THE HALL",
      "caption": "a monastery, at zazen", "at": [0.5, 0.155], "voice": "narrator",
      "i18n": { "ja": "僧院にて、坐禅のとき", "zh": "一座寺院，正在坐禅", "ta": "ஒரு மடம், தியானத்தில்",
                "es": "un monasterio, en zazen", "de": "ein Kloster, im Zazen" } },
    { "seq": 3,  "start": 6.5,  "end": 8.1,  "beat": "THE WAKING" },
    { "seq": 4,  "start": 8.1,  "end": 10.2, "beat": "THE CLAIM",
      "caption": "I found the truth!\nTell me — what is real?", "at": [0.62, 0.34], "voice": "student",
      "i18n": { "ja": "真理を見つけた！\n師よ — 何が実在なのですか？", "zh": "我悟到了真理！\n告诉我——什么是真实？",
                "ta": "உண்மையைக் கண்டுகொண்டேன்!\nசொல்லுங்கள் — எது நிஜம்?",
                "es": "¡He hallado la verdad!\nDime — ¿qué es real?",
                "de": "Ich habe die Wahrheit gefunden!\nSag mir — was ist wirklich?" } },
    { "seq": 5,  "start": 10.5, "end": 21.0, "beat": "THE DOUBLE-BIND",
      "caption": "Say it is real —\nI strike you.", "at": [0.36, 0.20], "voice": "teacher",
      "i18n": { "ja": "実在と言うなら —\n打つ。", "zh": "你说它是真的——\n我就打你。",
                "ta": "நிஜம் என்றால் —\nஅடிப்பேன்.", "es": "Si dices que es real —\nte golpeo.",
                "de": "Sagst du, er ist wirklich —\nschlage ich dich." } },
    { "seq": 6,  "start": 12.6, "end": 21.0, "beat": "THE DOUBLE-BIND",
      "caption": "Say it is imaginary —\nI strike you.", "at": [0.37, 0.31], "voice": "teacher",
      "i18n": { "ja": "幻と言うなら —\n打つ。", "zh": "你说它是虚幻——\n我就打你。",
                "ta": "மாயை என்றால் —\nஅடிப்பேன்.", "es": "Si dices que es ilusión —\nte golpeo.",
                "de": "Sagst du, er ist Illusion —\nschlage ich dich." } },
    { "seq": 7,  "start": 14.4, "end": 21.0, "beat": "THE DOUBLE-BIND",
      "caption": "Say nothing —\nI strike you.", "at": [0.38, 0.42], "voice": "teacher",
      "i18n": { "ja": "黙っていても —\n打つ。", "zh": "你不说话——\n我也打你。",
                "ta": "மௌனமாக இருந்தாலும் —\nஅடிப்பேன்.", "es": "Si callas —\nte golpeo.",
                "de": "Schweigst du —\nschlage ich dich." } },
    { "seq": 8,  "start": 16.0, "end": 21.0, "beat": "·" },
    { "seq": 9,  "start": 21.2, "end": 22.4, "beat": "THE BREAK" },
    { "seq": 10, "start": 22.4, "end": 29.0, "beat": "THE ACT" },
    { "seq": 12, "start": 33.4, "end": 38.0, "beat": "MNEMBYTE" },
    { "seq": 11, "start": 29.4, "end": 32.8, "beat": "ENSŌ",
      "caption": "he takes the stick — and breaks it", "at": [0.5, 0.82], "voice": "narrator",
      "i18n": { "ja": "彼は棒を取り — へし折った", "zh": "他夺过棍子——折断了它",
                "ta": "அவன் கம்பைப் பறித்து — முறித்தான்", "es": "toma el bastón — y lo rompe",
                "de": "er nimmt den Stock — und zerbricht ihn" } }
  ],

